\ProvidesPackage{assignment}

% ---------- basic packages ----------
\RequirePackage{amsmath, amssymb}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{siunitx}

\RequirePackage{pdfpages}
\RequirePackage{graphicx}
\RequirePackage{svg}

\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multicol}
\RequirePackage{enumitem}

\RequirePackage[letterpaper, margin=1in]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{extramarks}

% ---------- metadata defaults ----------
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=assignment, prefix=assignment@}
\DeclareStringOption[Due Date]{DueDate}
\DeclareStringOption[Assignment X]{AssignmentName}
\ProcessKeyvalOptions*

\providecommand{\CourseCode}{}
\providecommand{\CourseName}{}
\providecommand{\Instructor}{}
\providecommand{\Semester}{}
\providecommand{\AssignmentTitle}{}
\providecommand{\AssignmentAuthor}{Brody Jordan}
\providecommand{\AssignmentUIN}{431005357}

% ---------- page layout ----------
\geometry{
  letterpaper,
  margin=1in
}

\linespread{1.1}
\headsep=0.25in
\setlength\parindent{0pt}
\setlist{nosep}
\sisetup{detect-all=true}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\ifnum\value{page}>1 \topxmark \else \firstxmark \fi}
\fancyhead[C]{\CourseCode: \assignment@AssignmentName}
\fancyhead[R]{\AssignmentAuthor}
\fancyfoot[L]{\lastxmark}
\fancyfoot[C]{\thepage}
\renewcommand\headrulewidth{0.4pt}
\renewcommand\footrulewidth{0.4pt}

% ---------- title helper ----------
\date{}

\newcommand{\MakeAssignmentTitle}{
  \title{
    \vspace{2in}
    \LARGE{\textbf{\CourseCode: \assignment@AssignmentName}} \\
    \normalsize\vspace{0.1in}\normalsize{Due on \assignment@DueDate} \\
    \normalsize\vspace{0.1in}\small{Instructor: \Instructor} \\
    \vspace{2in}
    \large{\AssignmentAuthor \\ \AssignmentUIN}
  }

  \begin{titlepage}
    \maketitle
    \thispagestyle{empty}
  \end{titlepage}

  \pagebreak
}

% ---------- problem environment ----------
\newcounter{homeworkProblemCounter}
\setcounter{homeworkProblemCounter}{1}
\newenvironment{homeworkProblem}{%
  \par\nobreak
  \extramarks
    {Problem \arabic{homeworkProblemCounter}}
    {Problem \arabic{homeworkProblemCounter}}
  \extramarks
    {Problem \arabic{homeworkProblemCounter} (continued)}
    {Problem \arabic{homeworkProblemCounter} continued on next page\ldots}
  \section*{Problem \arabic{homeworkProblemCounter}}
}{%
  \par\nobreak
  \stepcounter{homeworkProblemCounter}
  \extramarks
    {Problem \arabic{homeworkProblemCounter}}
    {}
}

\newcounter{optionalProblemCounter}
\setcounter{optionalProblemCounter}{1}
\newenvironment{optionalProblem}{%
  \par\nobreak
  \extramarks
    {Optional Problem \arabic{optionalProblemCounter}}
    {Optional Problem \arabic{optionalProblemCounter}}
  \extramarks
    {Optional Problem \arabic{optionalProblemCounter} (continued)}
    {Optional Problem \arabic{optionalProblemCounter} continued on next page\ldots}
  \section*{Optional Problem \arabic{optionalProblemCounter}}
}{%
  \par\nobreak
  \stepcounter{optionalProblemCounter}
  \extramarks
    {Optional Problem \arabic{optionalProblemCounter}}
    {}
}

\newcounter{partCounter}
\renewcommand{\part}[1]{\textbf{\large Part \Alph{partCounter}}\stepcounter{partCounter}}
\newcommand{\solution}{\textbf{\Large Solution} \vspace{1\baselineskip}}

% ---------- parts list ----------
\setlist[enumerate,1]{label=(\alph*), ref=\alph*}


% ---------- hyperlink setup ----------
\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  urlcolor=blue
}
