\ProvidesPackage{notes}

\RequirePackage{math}

\renewcommand\labelitemi{\textbf{--}}

% ---------- basic packages ----------
\RequirePackage{amsmath, amssymb, amsthm, amsfonts}
\RequirePackage{graphicx}
\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{svg}

% ---------- page layout ----------
\geometry{
  margin=1in,
  letterpaper,
}

\setstretch{1.1}

% ---------- metadata defaults ----------
% (safe even if course.tex forgets something)
\providecommand{\CourseCode}{}
\providecommand{\CourseName}{}
\providecommand{\Instructor}{}
\providecommand{\Semester}{}

% ---------- title helper ----------
\newcommand{\makecoursetitle}{
    \begin{titlepage}
        \centering
        \vspace*{2.33cm}
        \noindent\rule{\linewidth}{1pt}\vspace*{10pt}\\
        \textbf{\Huge \CourseName}\\
        \vspace*{15pt}\textbf{\small TAMU\ \CourseCode}\\
        \noindent\rule{\linewidth}{1pt}\vspace*{10pt}\\
        \vspace*{10mm}
        {\Large \Student}\par
        \vspace{1mm}
        {\small \Semester}\par
        \vspace{15mm}
        \includegraphics[width=0.5\textwidth]{\Cover}
    \end{titlepage}

    \input{chapters/_acknowledgement.tex}
    \vspace*{\fill}

    
    \setstretch{1.2}
    \tableofcontents
    \setstretch{1.0}
}

% ---------- section styling ----------
\RequirePackage{titlesec}
\titleformat{\section}
  {\normalfont\large\bfseries}
  {\thesection}{1em}{}

\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{1em}{}


% ---------- hyperlink setup ----------
\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  urlcolor=blue,
  citecolor=blue
}